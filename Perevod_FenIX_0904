// --- КОД ---
var SCRIPT_NAME = "MONEY_SCRIPT";

if (GlobalVars.getBoolean(SCRIPT_NAME)) {
    GlobalVars.putBoolean(SCRIPT_NAME, false);
    Chat.log("§c╔══════════════════════════╗");
    Chat.log("§c║   СКРИПТ ОСТАНОВЛЕН     ║");
    Chat.log("§c╚══════════════════════════╝");
} else {
    GlobalVars.putBoolean(SCRIPT_NAME, true);
    Chat.log("§a╔══════════════════════════╗");
    Chat.log("§a║   СКРИПТ ЗАПУЩЕН        ║");
    Chat.log("§a╠══════════════════════════╣");
    Chat.log("§a║ Ищу: §f" + TWINK_NAME_START + "*");
    Chat.log("§a║ Сумма: §f" + PAY_AMOUNT);
    Chat.log("§a╠══════════════════════════╣");
    Chat.log("§a║ §fДля остановки перезапусти скрипт");
    Chat.log("§a╚══════════════════════════╝");
    
    var sentPlayers = [];
    var alreadySent = GlobalVars.getString("SENT_LIST") || "";
    var moneyCount = 0;
    var tpTimer = 0;
    
    if (TPACCEPT_ENABLED == 1) {
        Chat.say("/tpaccept");
        Chat.log("§7[TPACCEPT] Отправлен (старт)");
    }
    
    while (GlobalVars.getBoolean(SCRIPT_NAME)) {
        try {
            if (TPACCEPT_ENABLED == 1) {
                tpTimer++;
                if (tpTimer >= TPACCEPT_INTERVAL * 20) {
                    Chat.say("/tpaccept");
                    Chat.log("§7[TPACCEPT] Отправлен");
                    tpTimer = 0;
                }
            }
            
            if (tpTimer % 40 == 0) {
                var players = World.getPlayers();
                for (var i = 0; i < players.length; i++) {
                    var name = players[i].getName().replace(/§[0-9a-fk-or]/g, '');
                    
                    if (name.startsWith(TWINK_NAME_START)) {
                        if (alreadySent.indexOf(name) == -1 && sentPlayers.indexOf(name) == -1) {
                            Chat.log("§a╔══════════════════════════╗");
                            Chat.log("§a║ НАЙДЕН ТВИНК: " + name);
                            Chat.log("§a╚══════════════════════════╝");
                            
                            Chat.say("/pay " + name + " " + PAY_AMOUNT);
                            Client.waitTick(20);
                            Chat.say("/pay " + name + " " + PAY_AMOUNT);
                            
                            sentPlayers.push(name);
                            alreadySent += name + ",";
                            GlobalVars.putString("SENT_LIST", alreadySent);
                            moneyCount++;
                            
                            Chat.log("§a✓ Отправлено " + name);
                            Chat.log("§7Всего: §f" + moneyCount);
                            Client.waitTick(20);
                        }
                    }
                }
            }
            
        } catch(e) {
            Chat.log("§c[!] Ошибка: " + e);
        }
        
        Client.waitTick(1);
    }
    
    // ИТОГИ ТОЛЬКО ЕСЛИ РЕАЛЬНО РАБОТАЛ
    if (moneyCount > 0 || tpTimer > 0) {
        Chat.log("§e╔══════════════════════════╗");
        Chat.log("§e║   ИТОГИ РАБОТЫ         ║");
        Chat.log("§e╠══════════════════════════╣");
        Chat.log("§e║ Отправлено денег: §f" + moneyCount);
        if (TPACCEPT_ENABLED == 1) {
            Chat.log("§e║ /tpaccept: §fотправлялся");
        }
        Chat.log("§e║ Потрачено: §f" + (moneyCount * PAY_AMOUNT));
        Chat.log("§e╚══════════════════════════╝");
    }
}
